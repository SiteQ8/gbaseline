{
  "name": "gbaseline",
  "version": "0.1.0",
  "description": "An open weekly measurement of how well the public domains of the six Arabian Gulf states protect email, DNS and the web, with a live check for any domain, open data and an MCP server",
  "type": "module",
  "bin": {
    "gbaseline": "bin/cli.mjs"
  },
  "homepage": "https://gbaseline.3li.info",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiteQ8/gbaseline.git"
  },
  "bugs": {
    "url": "https://github.com/SiteQ8/gbaseline/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test test/engine.test.mjs test/probe.test.mjs test/pipeline.test.mjs test/data.test.mjs test/name.test.mjs test/mcp.test.mjs test/site.test.mjs test/naming.test.mjs test/readiness.test.mjs",
    "test:ui": "node test/ui.mjs",
    "preflight": "node scripts/preflight.mjs",
    "selftest": "node mcp/server.mjs --selftest",
    "weekly": "node bin/cli.mjs weekly",
    "start": "node mcp/server.mjs",
    "links": "node scripts/links.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "mcp/",
    "docs/assets/engine/",
    "docs/data/bundle.json",
    "docs/data/summary.json",
    "docs/data/history.json",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "Ali AlEnezi",
  "license": "MIT",
  "keywords": [
    "dmarc",
    "spf",
    "dnssec",
    "hsts",
    "tls",
    "post-quantum",
    "ml-kem",
    "security-txt",
    "observatory",
    "gcc",
    "kuwait",
    "saudi-arabia",
    "uae",
    "qatar",
    "bahrain",
    "oman",
    "open-data",
    "mcp",
    "mcp-server",
    "arabic",
    "bilingual"
  ]
}
